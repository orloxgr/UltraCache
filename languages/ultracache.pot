#: includes/admin-dashboard.js:8146
msgid "Runs a capped manual scan of uploads/uc-images. Normal dashboard/status refreshes stay passive and do not crawl media directories."
msgstr ""

#: includes/admin-dashboard.js:8154
msgid "Checks whether optimized output storage is missing and re-queues completed items when repair is needed."
msgstr ""

#: includes/admin-dashboard.js:8162
msgid "Moves failed queue rows back to pending so they can be processed again."
msgstr ""

#: includes/admin-dashboard.js:8170
msgid "Removes completed queue rows only. It does not delete AVIF/WebP files."
msgstr ""

#: includes/admin-dashboard.js:8173
msgid "Cache warm-up operations keep using the Warm Cache box above. This panel is used only for media queue actions."
msgstr ""

#: includes/admin-dashboard.js:8192
msgid "Cache Engine"
msgstr ""

#: includes/admin-dashboard.js:8193
msgid "Core page cache behavior, WooCommerce bypasses, compression variants, and safe prefetch hints."
msgstr ""

#: includes/admin-dashboard.js:8198
msgid "Page Caching"
msgstr ""

#: includes/admin-dashboard.js:8199
msgid "Store public pages as static HTML files."
msgstr ""

#: includes/admin-dashboard.js:8206
msgid "Pre-render on Save"
msgstr ""

#: includes/admin-dashboard.js:8207
msgid "Warm the updated page after content changes."
msgstr ""

#: includes/admin-dashboard.js:8214
msgid "WooCommerce Safe Mode"
msgstr ""

#: includes/admin-dashboard.js:8215
msgid "Bypass cart, checkout, account, order endpoints, and cart-changing requests."
msgstr ""

#: includes/admin-dashboard.js:8222
msgid "Browser Cache Headers"
msgstr ""

#: includes/admin-dashboard.js:8223
msgid "Write long-lived browser cache headers for CSS, JS, fonts, static images, AVIF, and WebP on Apache-compatible hosts."
msgstr ""

#: includes/admin-dashboard.js:8246
msgid "Speculation Rules Prefetch"
msgstr ""

#: includes/admin-dashboard.js:8247
msgid "Inject a safe prefetch-only speculationrules block for likely next-page internal navigations. Logged-in users, query-string links, WooCommerce flows, admin-like paths, nofollow links, and target/download links stay excluded."
msgstr ""

#: includes/admin-dashboard.js:8254
msgid "Cache Pages with Safe Tracking Cookies"
msgstr ""

#: includes/admin-dashboard.js:8255
msgid "Allow public HTML cache storage when the response sets only cookies from the Safe Tracking Cookies list. UltraCache still never stores or replays Set-Cookie headers. Disable for strict mode where any Set-Cookie must skip cache."
msgstr ""

#: includes/admin-dashboard.js:8268
msgid "Media Optimization"
msgstr ""

#: includes/admin-dashboard.js:8269
msgid "Controls frontend AVIF/WebP URL rewriting and the related upload, batch, and missing-media queue tools."
msgstr ""

#: includes/admin-dashboard.js:8274
msgid "Enable Media Rewrite"
msgstr ""

#: includes/admin-dashboard.js:8275
msgid "Enable AVIF/WebP media URL rewriting according to the selected output policy. The actual media files must already exist or be generated through batch conversion, generate on upload, or queue missing media on demand."
msgstr ""

#: includes/admin-dashboard.js:8282
msgid "Automatic Format"
msgstr ""

#: includes/admin-dashboard.js:8283
msgid "AVIF is preferred first, with WebP kept as the compatibility fallback."
msgstr ""

#: includes/admin-dashboard.js:8290
msgid "AVIF Format"
msgstr ""

#: includes/admin-dashboard.js:8291
msgid "Generate and prefer AVIF variants only."
msgstr ""

#: includes/admin-dashboard.js:8298
msgid "WebP Format"
msgstr ""

#: includes/admin-dashboard.js:8299
msgid "Generate and prefer WebP variants only."
msgstr ""

#: includes/admin-dashboard.js:8306
msgid "Generate on Upload"
msgstr ""

#: includes/admin-dashboard.js:8307
msgid "When enabled, newly uploaded images and their registered thumbnail sizes are queued for next-gen conversion."
msgstr ""

#: includes/admin-dashboard.js:8314
msgid "Queue Missing Media on Demand"
msgstr ""

#: includes/admin-dashboard.js:8315
msgid "When enabled, UltraCache queues missing AVIF/WebP variants discovered during frontend, warm-up, cron warm, or stale rewrites. The current request never performs image conversion; the existing background media queue handles generation."
msgstr ""

#: includes/admin-dashboard.js:8322
msgid "Safe CLS Dimensions"
msgstr ""

#: includes/admin-dashboard.js:8323
msgid "Inject missing width and height on local images using attachment metadata first and local file dimensions as fallback."
msgstr ""

#: includes/admin-dashboard.js:8330
msgid "LCP Image Priority"
msgstr ""

#: includes/admin-dashboard.js:8331
msgid "Prioritize likely hero/LCP images. In normal mode UltraCache can mark the detected candidate and inject a preload; when Fix sliders / hero sections is active, it uses SR7/Revolution Slider first-slide discovery plus a lifecycle-safe runtime guard."
msgstr ""

#: includes/admin-dashboard.js:8338
msgid "Lazy load & async images"
msgstr ""

#: includes/admin-dashboard.js:8339
msgid "Adds native loading=\"lazy\" and decoding=\"async\" to eligible images. If LCP Image Priority is enabled, UltraCache only lazy-loads images printed after the detected LCP image."
msgstr ""

#: includes/admin-dashboard.js:8352
msgid "This server cannot generate AVIF or WebP yet. Install Imagick with AVIF/WebP support or a GD build that includes imageavif()/imagewebp()."
msgstr ""

#: includes/admin-dashboard.js:8360
msgid "Frontend JS & Request Chains"
msgstr ""

#: includes/admin-dashboard.js:8361
msgid "Defer/delay safe scripts and prioritize known critical request chains."
msgstr ""

#: includes/admin-dashboard.js:8366
msgid "Safe Defer JS"
msgstr ""

#: includes/admin-dashboard.js:8367
msgid "Add native defer conservatively. When enabled, UltraCache scans the front page once and appends detected theme/page-builder init scripts to the visible JS Delay / Defer Exclusions list."
msgstr ""

#: includes/admin-dashboard.js:8374
msgid "Defer all JS"
msgstr ""

#: includes/admin-dashboard.js:8375
msgid "Aggressive manual mode. When Safe Defer JS is on, UltraCache adds native defer to every eligible frontend script. If JS Delay / Defer Exclusions is empty, UltraCache really defers everything eligible. Populate Defaults is optional and only adds visible recommendations; scan suggestions help you build exclusions after testing."
msgstr ""

#: includes/admin-dashboard.js:8382
msgid "Delay safe third-party JS"
msgstr ""

#: includes/admin-dashboard.js:8383
msgid "Delay analytics, pixels, ads, tracking, and marketing scripts until user interaction or a late safe fallback timeout, keeping them out of the initial PageSpeed/LCP/TBT critical window. Examples: Google Analytics, gtag, GTM, Google Site Kit event providers, Meta Pixel, TikTok Pixel, LinkedIn Insight, Pinterest Tag, Bing UET, Hotjar, Clarity, DoubleClick, Google Ads, Taboola, Outbrain, and Yahoo tracking."
msgstr ""

#: includes/admin-dashboard.js:8390
msgid "Lazy MailerLite nonce refresh"
msgstr ""

#: includes/admin-dashboard.js:8398
msgid "Delay known functional third-party JS"
msgstr ""

#: includes/admin-dashboard.js:8399
msgid "Delay matched third-party scripts that provide visible functionality, such as cookie banners, captcha, maps, chat widgets, booking widgets, embedded forms, opt-in popups, newsletter widgets, and review widgets. Matching is based on the visible include/exclude patterns below. If a form, map, captcha, checkout, or cookie banner misbehaves, add its script keyword to exclusions."
msgstr ""

#: includes/admin-dashboard.js:8406
msgid "Delay all third-party JS"
msgstr ""

#: includes/admin-dashboard.js:8407
msgid "Delays external scripts loaded from third-party domains until user interaction or a safe fallback timeout. JS Delay / Defer Exclusions is respected; use exclusions for captcha, payments, consent, login, booking, or critical form scripts that must run immediately."
msgstr ""

#: includes/admin-dashboard.js:8414
msgid "Delay non-critical/local JS"
msgstr ""

#: includes/admin-dashboard.js:8415
msgid "Delay selected same-host enhancement scripts such as popups, sliders, filters, consent extras, marketing helpers, and other local footer scripts unless protected or excluded here."
msgstr ""

#: includes/admin-dashboard.js:8422
msgid "Main Thread Relief"
msgstr ""

#: includes/admin-dashboard.js:8423
msgid "Load delayed scripts gradually during browser idle time instead of releasing the full delayed queue at once. Works with Stage two and Stage three delayed scripts."
msgstr ""

#: includes/admin-dashboard.js:8430
msgid "Critical Request Chain Relief"
msgstr ""

#: includes/admin-dashboard.js:8431
msgid "Preload known critical requests and let selected non-critical chained assets be delayed so the browser has a shorter critical network chain."
msgstr ""

#: includes/admin-dashboard.js:8438
msgid "LCP Boundary Defer"
msgstr ""

#: includes/admin-dashboard.js:8439
msgid "Uses the LCP image detected by LCP Image Priority as a visual boundary. Eligible local scripts printed after that image in the HTML are delayed."
msgstr ""

#: includes/admin-dashboard.js:8450
msgid "CSS Delivery"
msgstr ""

#: includes/admin-dashboard.js:8451
msgid "Bundle eligible CSS and async low-risk stylesheets without changing media-related controls."
msgstr ""

#: includes/admin-dashboard.js:8456
msgid "CSS Bundling"
msgstr ""

#: includes/admin-dashboard.js:8457
msgid "Create local UltraCache CSS bundles for eligible stylesheet links. Safe mode is the public default. Aggressive and Full CSS Bundle are experimental and should be enabled only after visual testing."
msgstr ""

#: includes/admin-dashboard.js:8464
msgid "CSS Bundling Scope"
msgstr ""

#: includes/admin-dashboard.js:8465
msgid "Choose exactly one scope for generated CSS bundles. Homepage only is safest, shared reuses the homepage bundle where possible, and per-page creates separate bundles for cacheable pages."
msgstr ""

#: includes/admin-dashboard.js:8470
msgid "Homepage only"
msgstr ""

#: includes/admin-dashboard.js:8471
msgid "Shared site bundle"
msgstr ""

#: includes/admin-dashboard.js:8472
msgid "Per-page bundles"
msgstr ""

#: includes/admin-dashboard.js:8476
msgid "CSS Bundle Mode"
msgstr ""

#: includes/admin-dashboard.js:8477
msgid "Choose how broadly UltraCache combines eligible local stylesheet links. Safe is recommended for public defaults; Aggressive and Full CSS Bundle are experimental and can increase blocking CSS or break layouts on some themes."
msgstr ""

#: includes/admin-dashboard.js:8484
msgid "Full CSS Bundle"
msgstr ""

#: includes/admin-dashboard.js:8489
msgid "Inline CSS Bundling"
msgstr ""

#: includes/admin-dashboard.js:8490
msgid "Inline the generated page CSS bundle directly into the document head. This is user-controlled and can greatly increase cached HTML size when the generated bundle is large; STORE profiler now shows final HTML size, inline CSS bytes, and fallback counts."
msgstr ""

#: includes/admin-dashboard.js:8497
msgid "Consolidate Remaining CSS"
msgstr ""

#: includes/admin-dashboard.js:8498
msgid "After the main CSS bundle is injected, combine eligible leftover non-protected local stylesheet links into one extra CSS file. SR7/Revolution/Swiper/Slick hero CSS remains protected; this targets small leftover plugin/theme CSS calls that still block rendering."
msgstr ""

#: includes/admin-dashboard.js:8505
msgid "First Visit CSS Bundle Handling"
msgstr ""

#: includes/admin-dashboard.js:8506
msgid "Choose what happens when a visitor opens a page before its CSS bundle exists."
msgstr ""

#: includes/admin-dashboard.js:8511
msgid "Do nothing"
msgstr ""

#: includes/admin-dashboard.js:8512
msgid "Build CSS bundle on entry"
msgstr ""

#: includes/admin-dashboard.js:8513
msgid "Build CSS bundle async"
msgstr ""

#: includes/admin-dashboard.js:8517
msgid "Async Remaining CSS"
msgstr ""

#: includes/admin-dashboard.js:8518
msgid "Rewrite low-risk local stylesheet links and UltraCache-generated external CSS bundles/optimized CSS to non-blocking print+onload loading with a noscript fallback. This complements CSS Bundling."
msgstr ""

#: includes/admin-dashboard.js:8529
msgid "Fonts Optimization"
msgstr ""

#: includes/admin-dashboard.js:8530
msgid "Optimize remote Google Fonts, local @font-face display behavior, self-hosted font CSS delivery, and optional delayed icon-font loading."
msgstr ""

#: includes/admin-dashboard.js:8535
msgid "Font Display Optimization"
msgstr ""

#: includes/admin-dashboard.js:8536
msgid "Adds font-display: swap to local @font-face declarations when missing and appends display=swap to remote Google Fonts requests. Uses the existing Google Fonts Swap setting internally for backward compatibility."
msgstr ""

#: includes/admin-dashboard.js:8543
msgid "Local Google Fonts Optimization"
msgstr ""

#: includes/admin-dashboard.js:8544
msgid "Opt-in feature. Download Google Fonts CSS and WOFF2 files into the UltraCache cache, rewrite frontend Google Fonts links and Google Fonts @import rules found in loaded same-origin CSS, and keep font-display: swap on localized CSS. This feature makes outbound requests to Google Fonts when building the local cache."
msgstr ""

#: includes/admin-dashboard.js:8555
msgid "Optimize Self-Hosted Font CSS"
msgstr ""

#: includes/admin-dashboard.js:8556
msgid "Rewrite local and inline @font-face CSS to add font-display: swap, prefer matching WOFF2 sources when available, normalize font URLs, and preload up to two likely first-paint WOFF2 files."
msgstr ""

#: includes/admin-dashboard.js:8563
msgid "Delay icon font-face blocks"
msgstr ""

#: includes/admin-dashboard.js:8564
msgid "Detect matching icon-font @font-face blocks in bundled or standalone CSS and load them through a non-render-blocking delayed font stylesheet. This can reduce critical font loading, but icons may appear slightly later."
msgstr ""

#: includes/admin-dashboard.js:8571
msgid "Auto-detect likely icon fonts"
msgstr ""

#: includes/admin-dashboard.js:8572
msgid "Use broad icon-font heuristics such as Font Awesome, eicons, dashicons, icomoon, flaticon, theme icon fonts, private unicode glyph usage, and /icons/ or /webfonts/ paths. The visible include/exclude lists below still win."
msgstr ""

#: includes/admin-dashboard.js:8579
msgid "Advanced Runtime Font CSS Rewrite"
msgstr ""

#: includes/admin-dashboard.js:8580
msgid "Advanced opt-in / experimental. Uses a MutationObserver to rewrite late-injected local font stylesheet links. Keep off unless a site specifically needs runtime font-link rewriting."
msgstr ""

#: includes/admin-dashboard.js:8591
msgid "Safe Asset Cleanup"
msgstr ""

#: includes/admin-dashboard.js:8592
msgid "Optional cleanup for WooCommerce product/gallery/filter assets when they are not detected as needed."
msgstr ""

#: includes/admin-dashboard.js:8596
msgid "Enable Asset Chain Cleanup"
msgstr ""

#: includes/admin-dashboard.js:8596
msgid "Cleans selected unnecessary frontend assets from cached HTML and late WordPress queues. Test homepage, shop, product, cart, checkout, and header search after enabling."
msgstr ""

#: includes/admin-dashboard.js:8597
msgid "Clean WooCommerce product/gallery assets outside product pages"
msgstr ""

#: includes/admin-dashboard.js:8597
msgid "Removes zoom, flexslider, PhotoSwipe, variation, and single-product assets when the cached HTML is not a single product page."
msgstr ""

#: includes/admin-dashboard.js:8598
msgid "Clean product filter assets when no filter is detected"
msgstr ""

#: includes/admin-dashboard.js:8598
msgid "Removes WOOF/filter scripts and styles when UltraCache cannot detect filter markup in the generated HTML."
msgstr ""

#: includes/admin-dashboard.js:8599
msgid "Clean WooCommerce Blocks CSS when no Woo blocks are detected"
msgstr ""

#: includes/admin-dashboard.js:8608
msgid "Advanced Settings & Exclusions"
msgstr ""

#: includes/admin-dashboard.js:8609
msgid "Manual include/exclude lists and higher-risk toggles for frontend delivery, CSS/JS handling, asset cleanup, and LCP image handling."
msgstr ""

#: includes/admin-dashboard.js:8615
msgid "Fix sliders / hero sections"
msgstr ""

#: includes/admin-dashboard.js:8616
msgid "When Revolution Slider, SR7, Swiper, Slick, or similar hero/slider markup is detected, UltraCache protects slider/runtime assets, skips risky structural rewrites, and keeps SR7 first-slide LCP priority on the lifecycle-safe path when LCP Image Priority is enabled."
msgstr ""

#: includes/admin-dashboard.js:8623
msgid "Enable Debug"
msgstr ""

#: includes/admin-dashboard.js:8624
msgid "Allow request-triggered UltraCache debug/source headers such as X-Ultra-Cache-Source when X-UltraCache-Debug: 1 is sent. Keep OFF on production unless actively debugging."
msgstr ""

#: includes/admin-dashboard.js:8631
msgid "Aggressive Async CSS"
msgstr ""

#: includes/admin-dashboard.js:8632
msgid "Optional advanced mode. Rewrite almost all remaining local stylesheet links, including late footer output, to non-blocking print+onload loading with a noscript fallback. Use the exclude list for styles that must stay blocking."
msgstr ""

#: includes/admin-dashboard.js:8639
msgid "Enable query-string args caching"
msgstr ""

#: includes/admin-dashboard.js:8640
msgid "Allow UltraCache to cache URL variants that include query-string args. Excluded query-string args always bypass cache. If the whitelist below is empty, all non-excluded query-string variants can be cached."
msgstr ""

#: includes/admin-dashboard.js:8648
msgid "Exclude Paths From Caching"
msgstr ""

#: includes/admin-dashboard.js:8649
msgid "One path per line. This is the visible/editable cache path safeguard list. Reset restores defaults; Populate re-adds recommended defaults without resetting all settings."
msgstr ""

#: includes/admin-dashboard.js:8655
#: includes/admin-dashboard.js:8668
#: includes/admin-dashboard.js:8719
#: includes/admin-dashboard.js:8732
#: includes/admin-dashboard.js:8765
#: includes/admin-dashboard.js:8829
#: includes/admin-dashboard.js:8842
msgid "Populate Defaults"
msgstr ""

#: includes/admin-dashboard.js:8661
msgid "Excluded query-string args from Caching"
msgstr ""

#: includes/admin-dashboard.js:8662
msgid "One query key per line. This is the visible/editable unsafe query-arg safeguard list. Reset restores defaults; Populate re-adds recommended defaults without resetting all settings."
msgstr ""

#: includes/admin-dashboard.js:8674
msgid "Query-string args whitelist"
msgstr ""

#: includes/admin-dashboard.js:8675
msgid "Optional. One query key per line. When query-string caching is enabled, UltraCache caches a query-string URL only when every query arg is listed here. Populate appends detected attributes, taxonomies, categories and tags without removing custom entries."
msgstr ""

#: includes/admin-dashboard.js:8681
msgid "Populate"
msgstr ""

#: includes/admin-dashboard.js:8687
msgid "Additional URLs for Google Fonts scanning"
msgstr ""

#: includes/admin-dashboard.js:8694
msgid "Rebuild Google Fonts Cache"
msgstr ""

#: includes/admin-dashboard.js:8695
msgid "Rebuilding…"
msgstr ""

#: includes/admin-dashboard.js:8701
msgid "Defer those scripts"
msgstr ""

#: includes/admin-dashboard.js:8702
msgid "Optional newline-separated handle or URL fragments. Matching frontend scripts are forced to native defer even when Defer JS is off or the script would normally be protected. Use carefully for scripts you explicitly want deferred."
msgstr ""

#: includes/admin-dashboard.js:8712
msgid "Safe Third-Party Delay Patterns"
msgstr ""

#: includes/admin-dashboard.js:8713
msgid "Visible/default patterns used by Delay safe third-party JS. Matching analytics, pixels, ads, tracking, and marketing script tags are delayed unless excluded. Safe third-party scripts use a later automatic fallback than functional/local delayed scripts."
msgstr ""

#: includes/admin-dashboard.js:8725
msgid "Known Functional Third-Party Delay Patterns"
msgstr ""

#: includes/admin-dashboard.js:8726
msgid "Visible/default patterns used by Delay known functional third-party JS. Matching consent, captcha, maps, chat, booking, embedded form, opt-in popup, newsletter, and widget scripts are delayed unless excluded."
msgstr ""

#: includes/admin-dashboard.js:8738
msgid "Priority Preloads"
msgstr ""

#: includes/admin-dashboard.js:8739
msgid "Optional newline-separated priority resources for early discovery. Prefix each line with image, style, script, font, or fetch. Use fetch for dynamic frontend requests, slider JSON/assets, or request chains that are not discovered early in the initial HTML. Image entries receive fetchpriority=high."
msgstr ""

#: includes/admin-dashboard.js:8748
msgid "Delay Non-Critical Request Chains"
msgstr ""

#: includes/admin-dashboard.js:8749
msgid "Optional newline-separated handle or URL fragments. Matching local scripts are delayed and matching stylesheets are converted to async print/onload loading."
msgstr ""

#: includes/admin-dashboard.js:8758
msgid "Asset Cleanup Exclusions"
msgstr ""

#: includes/admin-dashboard.js:8759
msgid "Optional newline-separated handle, URL, or HTML fragments. This is the visible/editable Asset Cleanup safeguard list for builders, search, carts, checkout, and custom widgets."
msgstr ""

#: includes/admin-dashboard.js:8772
msgid "Async CSS Exclude List"
msgstr ""

#: includes/admin-dashboard.js:8773
msgid "Optional newline-separated handle or URL fragments. Matching stylesheets stay in the normal blocking flow for both Enable Async CSS and Aggressive Async CSS. This is the single visible/editable Async CSS safeguard list."
msgstr ""

#: includes/admin-dashboard.js:8782
msgid "Manual LCP selector"
msgstr ""

#: includes/admin-dashboard.js:8783
msgid "Optional newline-separated CSS selectors, plain IDs, or image URL/fragments for the main above-the-fold hero/LCP target. CSS entries scope LCP discovery to that block; image entries become manual LCP preload targets."
msgstr ""

#: includes/admin-dashboard.js:8794
msgid "Delay These Fonts / Patterns"
msgstr ""

#: includes/admin-dashboard.js:8795
msgid "Newline-separated font-family, filename, or URL fragments. Scan the front page or add manual patterns. Matching @font-face blocks from bundled or standalone CSS are moved into a delayed non-render-blocking font stylesheet. Use this mainly for icon fonts."
