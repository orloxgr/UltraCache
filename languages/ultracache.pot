msgid "Control which query-string URL variants are eligible for public HTML cache."
msgstr ""

#: includes/admin-dashboard.js:10440
msgid "Enable query-string args caching"
msgstr ""

#: includes/admin-dashboard.js:10441
msgid "Allow UltraCache to cache URL variants that include query-string args. Excluded query-string args always bypass cache. The whitelist below must contain every query key; an empty whitelist bypasses query-string caching."
