msgstr ""

#: includes/admin-dashboard.js:10347
msgid "Use Delayed JS auto-start to mirror the JavaScript release timer and selected event triggers, or choose a WooCommerce-specific fallback timer."
msgstr ""

#: includes/admin-dashboard.js:10353
msgid "Use Delayed JS auto-start"
msgstr ""

#: includes/admin-dashboard.js:10363
msgid "Enable WooCommerce asset cleanup"
msgstr ""

#: includes/admin-dashboard.js:10363
msgid "Cleans selected unnecessary WooCommerce frontend assets from cached HTML and late WordPress queues. Test homepage, shop, product, cart, checkout, and header search after enabling."
msgstr ""

#: includes/admin-dashboard.js:10364
msgid "Clean WooCommerce product/gallery assets outside product pages"
msgstr ""

#: includes/admin-dashboard.js:10364
msgid "Removes zoom, flexslider, PhotoSwipe, variation, and single-product assets when the cached HTML is not a single product page."
msgstr ""

#: includes/admin-dashboard.js:10365
msgid "Clean product filter assets when no filter is detected"
msgstr ""

#: includes/admin-dashboard.js:10365
msgid "Removes WOOF/filter scripts and styles when UltraCache cannot detect filter markup in the generated HTML."
msgstr ""

#: includes/admin-dashboard.js:10366
msgid "Clean WooCommerce Blocks CSS when no Woo blocks are detected"
msgstr ""

#: includes/admin-dashboard.js:10366
msgid "Removes wc-blocks.css from cached HTML when no WooCommerce block markup is present."
msgstr ""

#: includes/admin-dashboard.js:10373
msgid "Advanced settings"
msgstr ""

#: includes/admin-dashboard.js:10374
msgid "General advanced controls kept separate from exclusion lists."
msgstr ""

#: includes/admin-dashboard.js:10378
msgid "Lazy MailerLite nonce refresh"
msgstr ""

#: includes/admin-dashboard.js:10386
msgid "Main Thread Relief"
msgstr ""

#: includes/admin-dashboard.js:10387
msgid "Load delayed scripts gradually during browser idle time instead of releasing the full delayed queue at once. Works with Stage two and Stage three delayed scripts."
msgstr ""

#: includes/admin-dashboard.js:10394
msgid "Critical Request Chain Relief"
msgstr ""

#: includes/admin-dashboard.js:10395
msgid "Preload known critical requests and let selected non-critical chained assets be delayed so the browser has a shorter critical network chain."
msgstr ""

#: includes/admin-dashboard.js:10402
msgid "Fix sliders / hero sections"
msgstr ""

#: includes/admin-dashboard.js:10403
msgid "When Revolution Slider, SR7, Swiper, Slick, or similar hero/slider markup is detected, UltraCache protects slider/runtime assets, skips risky structural rewrites, and keeps SR7 first-slide LCP priority on the lifecycle-safe path when LCP Image Priority is enabled."
msgstr ""

#: includes/admin-dashboard.js:10410
msgid "Enable Debug"
msgstr ""

#: includes/admin-dashboard.js:10411
msgid "Allow request-triggered UltraCache debug/source headers such as X-Ultra-Cache-Source when X-UltraCache-Debug: 1 is sent. Keep OFF on production unless actively debugging."
