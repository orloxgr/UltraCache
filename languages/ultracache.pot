msgstr ""

#: includes/admin-dashboard.js:10059
msgid "Delay safe third-party JS"
msgstr ""

#: includes/admin-dashboard.js:10060
msgid "Delay analytics, pixels, ads, tracking, and marketing scripts according to the unified Delayed JS auto-start controls, keeping them out of the initial PageSpeed/LCP/TBT critical window. Examples: Google Analytics, gtag, GTM, Google Site Kit event providers, Meta Pixel, TikTok Pixel, LinkedIn Insight, Pinterest Tag, Bing UET, Hotjar, Clarity, DoubleClick, Google Ads, Taboola, Outbrain, and Yahoo tracking."
msgstr ""

#: includes/admin-dashboard.js:10067
msgid "Delay non-critical/local JS"
msgstr ""

#: includes/admin-dashboard.js:10068
msgid "Delay selected same-host enhancement scripts such as popups, sliders, filters, consent extras, marketing helpers, and other local footer scripts unless protected or excluded here."
msgstr ""

#: includes/admin-dashboard.js:10075
msgid "Delay known functional third-party JS"
msgstr ""

#: includes/admin-dashboard.js:10076
msgid "Delay matched third-party scripts that provide visible functionality, such as cookie banners, captcha, maps, chat widgets, booking widgets, embedded forms, opt-in popups, newsletter widgets, and review widgets. Matching is based on the visible include/exclude patterns below. If a form, map, captcha, checkout, or cookie banner misbehaves, add its script keyword to exclusions."
msgstr ""

#: includes/admin-dashboard.js:10083
msgid "Delay all third-party JS"
msgstr ""

#: includes/admin-dashboard.js:10084
msgid "Delays external scripts loaded from third-party domains according to the unified Delayed JS auto-start controls. Defer Instead of Delay and Do Not Defer or Delay are respected; use Do Not Defer or Delay for captcha, payments, consent, login, booking, or critical form scripts that must run immediately."
msgstr ""

#: includes/admin-dashboard.js:10092
msgid "Delayed JS auto-start"
msgstr ""

#: includes/admin-dashboard.js:10092
msgid ""
"What it does: controls when all delayed JavaScript queues are allowed to run.\n"
"\n"
"Why it helps: delayed scripts stay out of the first loading rush, then release by visitor interaction or by the fallback timer.\n"
"\n"
"Watch for: event triggers are useful when a widget must wake as soon as the visitor interacts. Leaving events off gives a cleaner timer-only test."
msgstr ""

#: includes/admin-dashboard.js:10093
msgid "Controls when all delayed JavaScript queues are released. Applies to Delay all JS, Delay non-critical/local JS, LCP Boundary Delay, known functional third-party delay, and all third-party delay."
msgstr ""

#: includes/admin-dashboard.js:10095
msgid "Event triggers"
msgstr ""

#: includes/admin-dashboard.js:10096
msgid "Optional. Keep these off for pure timer-based release. If enabled, these events can request the delayed JS queue release."
msgstr ""

#: includes/admin-dashboard.js:10103
msgid "If no event happens, autostart JS after"
msgstr ""

#: includes/admin-dashboard.js:10104
msgid "Fallback timer for all delayed JavaScript queues."
msgstr ""

